    "%@ is a link to %@. PadBuddy will not write through it because that could change a file outside the folder you selected. Edit that file directly, or replace the link with a regular file." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es un enlace a %@. PadBuddy no escribirá a través de él porque podría modificar un archivo fuera de la carpeta seleccionada. Edita ese archivo directamente o sustituye el enlace por un archivo normal."
          }
        }
      }
    },
    "%@ is a link to %@. PadBuddy will not write through it, because that would change a file outside the folder you picked. Edit that file directly, or replace the link with a real config file." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is a link to %2$@. PadBuddy will not write through it, because that would change a file outside the folder you picked. Edit that file directly, or replace the link with a real config file."
          }
        },
        "es" : {
