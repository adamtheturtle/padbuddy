            "value" : "· %@"
          }
        }
      }
    },
    "\"%@\" already exists and is not empty. Choose a new folder name to export into." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" ya existe y no está vacía. Elige otro nombre de carpeta para la exportación."
          }
        }
      }
    },
    "\"%@\" already exists. Replacing it removes old exported files before saving the current pad code." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" ya existe. Al reemplazarlo, se eliminan los archivos exportados anteriores antes de guardar el código actual del pad."
          }
        }
      }
    },
    "“%@” and its stored API key will be removed from this Mac. Downloaded pads, questions, organization, quota, pad details, favorites, recent-pad history, saved list state, and unfinished edits for this account will also be deleted. This can’t be undone." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” and its stored API key will be removed from this Mac. Downloaded pads, questions, organisation, quota, pad details, favourites, recent-pad history, saved list state, and unfinished edits for this account will also be deleted. This can’t be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» y su clave de API guardada se eliminarán de este Mac. También se eliminarán los pads descargados, las preguntas, la organización, la cuota, los detalles de los pads, los favoritos, el historial de pads recientes, el estado guardado de las listas y las ediciones sin terminar de esta cuenta. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "“%@” is not a valid email address." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” no es una dirección de correo válida."
          }
        }
      }
    },
    "“%@” will be permanently deleted. This cannot be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” se eliminará permanentemente. Esto no se puede deshacer."
          }
        }
      }
    },
    "\"%@\" will be removed. Screen will stop sending event callbacks until a new webhook is set." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se eliminará «%@». Screen dejará de enviar devoluciones de llamada de eventos hasta que se configure un nuevo webhook."
          }
        }
      }
    },
