    "PadBuddy" : {
      "shouldTranslate" : false
    },
    "PadBuddy connects to your CoderPad account with an API key, then keeps your pads and questions a click away. Add an account to get started." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PadBuddy se conecta a tu cuenta de CoderPad con una clave de API y mantiene tus pads y preguntas a un clic de distancia. Añade una cuenta para empezar."
          }
        }
      }
    },
    "PadBuddy could not complete the update — %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PadBuddy no pudo completar la actualización — %@"
          }
        }
      }
    },
    "PadBuddy could not find its own program file, so it cannot tell %@ where to find it. Move PadBuddy to your Applications folder and try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PadBuddy no pudo encontrar su propio archivo de programa, así que no puede indicarle a %@ dónde encontrarlo. Mueve PadBuddy a la carpeta Aplicaciones y vuelve a intentarlo."
          }
        }
      }
    },
    "PadBuddy could not prepare manual setup instructions for this executable." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PadBuddy no pudo preparar las instrucciones de configuración manual para este ejecutable."
          }
        }
      }
    },
    "PadBuddy could not prepare the updated configuration — %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PadBuddy no pudo preparar la configuración actualizada — %@"
          }
        }
      }
    },
    "PadBuddy could not read the configuration — %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PadBuddy no pudo leer la configuración — %@"
          }
        }
      }
    },
    "PadBuddy could not restore the configuration — %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PadBuddy no pudo restaurar la configuración — %@"
          }
        }
      }
    },
    "PadBuddy could not verify the written server entry. The previous file remains in the backup." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PadBuddy no pudo verificar la entrada de servidor escrita. El archivo anterior permanece en la copia de seguridad."
          }
        }
      }
    },
    "PadBuddy could not write the configuration — %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PadBuddy no pudo escribir la configuración — %@"
          }
        }
      }
    },
    "PadBuddy is offline, so it cannot create a pad. Try again once you're connected." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PadBuddy está sin conexión, así que no puede crear un pad. Vuelve a intentarlo cuando tengas conexión."
          }
        }
      }
    },
    "PadBuddy keeps the last downloaded data until a refresh succeeds." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PadBuddy conserva los últimos datos descargados hasta que una actualización se complete correctamente."
