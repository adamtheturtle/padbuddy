<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store distribution entitlements (#483). Identical to
	     coderpad/coderpad.entitlements EXCEPT it omits the Sparkle
	     com.apple.security.temporary-exception.mach-lookup.global-name array:
	     the App Store forbids third-party updaters, and the App Store build's
	     target does not link Sparkle (so canImport(Sparkle) is false and the
	     updater code compiles out). The mach-lookup temporary exceptions would
	     otherwise cause an App Review rejection. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Team-ID-prefixed app group, matching the Developer ID build (#451) so the
	     widget and app continue to share their App Group container. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>6L9H6Q8CUF.group.com.adamdangoor.padbuddy</string>
	</array>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Sandboxed printing (#524): without this NSPrintOperation fails with
	     "This application does not support printing." Mirrors the Developer-ID
	     entitlements; needs no provisioning profile. -->
	<key>com.apple.security.print</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
