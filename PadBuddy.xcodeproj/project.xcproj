      "version": {
        "version": "0.5.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/adamtheturtle/CommandPaletteKit",
      "version": {
        "version": "0.3.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/SvenTiigi/WhatsNewKit.git",
      "version": {
        "up-to-next-major-version": "2.2.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/adamtheturtle/CoderPadKit.git",
      "version": {
        "version": "0.7.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/adamtheturtle/MCPKit/",
      "version": {
        "version": "0.5.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/adamtheturtle/MacPullToRefresh",
      "version": {
        "version": "0.6.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-async-algorithms",
      "version": {
        "up-to-next-major-version": "1.1.5",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/adamtheturtle/PrintableView",
      "version": {
        "up-to-next-major-version": "0.5.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/adamtheturtle/SafeURLKit.git",
      "version": {
        "version": "0.2.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/adamtheturtle/MCPClientInstall.git",
      "version": {
        "version": "0.4.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/ekscrypto/SwiftEmailValidator.git",
      "version": {
        "up-to-next-major-version": "1.7.0",
      },
    },
  ],
  "files": [
    { "path": "RecentPadsWidgetExtension.entitlements" },
    {
      "kind": "folder",
      "path": "PadBuddy",
      "target-membership": [
        "PadBuddy",
        "PadBuddy-AppStore",
      ],
      "membership-exceptions": [
        {
          "target": "PadBuddy",
          "exclusions": [
            "Info.plist",
          ],
        }, {
          "target": "PadBuddy-AppStore",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "PadBuddyTests", "target-membership": [ "PadBuddyTests" ] },
    { "kind": "folder", "path": "PadBuddyUITests", "target-membership": [ "PadBuddyUITests" ] },
    {
      "kind": "folder",
      "path": "RecentPadsWidget",
      "target-membership": [
        "RecentPadsWidgetExtension",
      ],
      "membership-exceptions": [
        {
          "target": "RecentPadsWidgetExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "RecentPadsWidgetExtension/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "RecentPadsWidgetExtension/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/PadBuddy.app", "id": "66C8C50B2FA73AB0009B720C", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/PadBuddyTests.xctest", "id": "66C8C51A2FA73AB2009B720C", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/PadBuddyUITests.xctest", "id": "66C8C5242FA73AB2009B720C", "type": "wrapper.cfbundle", "index": false },
        {
          "path": "<PRODUCTS>/RecentPadsWidgetExtension.appex",
          "id": "66E3CDBD2FDD6D1C00FE87A9",
          "type": "wrapper.app-extension",
          "index": false,
          "target-membership": [
            { "build-phase": "PadBuddy/copy/Embed Foundation Extensions", "platforms": [ "ios", "macos", "xros" ], "header-preservation": "remove-on-copy" },
            { "build-phase": "PadBuddy-AppStore/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" },
          ],
        },
        { "path": "<PRODUCTS>/PadBuddy-AppStore.app", "id": "66F5440C2FE5EECD000214AA", "type": "wrapper.application", "index": false },
        {
          "path": "<PRODUCTS>/PadBuddy Watch App.app",
          "id": "6C156DF9EEC8F4F04BAECB6C",
          "type": "wrapper.application",
          "index": false,
          "target-membership": [
            { "build-phase": "PadBuddy/copy/Embed Watch Content", "platforms": [ "ios" ], "header-preservation": "remove-on-copy" },
            { "build-phase": "PadBuddy-AppStore/copy/Embed Watch Content", "platforms": [ "ios" ], "header-preservation": "remove-on-copy" },
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "PadBuddy Watch App Sources",
      "children": [
        { "path": "PadBuddy/CompanionCredentials.swift", "index": true, "target-membership": [ "PadBuddy Watch App/compile-sources" ] },
        { "path": "PadBuddy/SingleResume.swift", "index": true, "target-membership": [ "PadBuddy Watch App/compile-sources" ] },
        { "path": "PadBuddy/WatchApp.swift", "index": true, "target-membership": [ "PadBuddy Watch App/compile-sources" ] },
        { "path": "PadBuddy/TVProvisioningRequest.swift", "index": true, "target-membership": [ "PadBuddy Watch App/compile-sources" ] },
        { "path": "PadBuddy/CompanionPlatformPolicy.swift", "index": true, "target-membership": [ "PadBuddy Watch App/compile-sources" ] },
        { "path": "WatchApp/PrivacyInfo.xcprivacy", "target-membership": [ "PadBuddy Watch App/resources" ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "PadBuddy",
      "id": "66C8C50A2FA73AB0009B720C",
      "product": "Products/PadBuddy.app",
      "product-type": "application",
      "dependencies": [
        { "target": "RecentPadsWidgetExtension", "platforms": [ "ios", "macos", "xros" ] },
        { "target": "PadBuddy Watch App", "platforms": [ "ios" ] },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        },
      ],
      "package-product-members": [
        {
          "package": "AppGroupMailbox",
          "product-name": "AppGroupMailbox",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios", "macos", "tvos", "xros" ] },
        }, {
          "package": "CoderPadKit",
          "product-name": "CoderPadKit",
