{
  "default-configuration": "Release",
  "configurations": [
    "AppStoreRelease",
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "en-GB",
      "es",
    ],
  },
  "packages": [
    {
      "kind": "remote",
