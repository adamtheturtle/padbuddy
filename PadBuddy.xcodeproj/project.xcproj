        }, {
          "package": "FastList",
          "product-name": "FastList",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios", "macos", "tvos", "xros" ] },
        }, {
          "package": "Highlightr",
          "product-name": "Highlightr",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios", "macos", "tvos", "xros" ] },
        }, {
          "package": "Highlightr",
          "product-name": "Highlightr",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "MCPClientInstall",
          "product-name": "MCPClientInstall",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "macos" ] },
        }, {
          "package": "MCPKit",
          "product-name": "MCPKit",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios", "macos", "tvos", "xros" ] },
        }, {
          "package": "MacPullToRefresh",
          "product-name": "MacPullToRefresh",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios", "macos", "tvos", "xros" ] },
        }, {
          "package": "Nuke",
          "product-name": "Nuke",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios", "macos", "tvos", "xros" ] },
        }, {
          "package": "PrintableView",
          "product-name": "PrintableView",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios", "macos" ] },
        }, {
          "package": "SafeURLKit",
          "product-name": "SafeURLKit",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios", "macos", "tvos", "xros" ] },
        }, {
          "package": "Sparkle",
          "product-name": "Sparkle",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "macos" ] },
        }, {
          "package": "SwiftEmailValidator",
          "product-name": "SwiftEmailValidator",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios", "macos", "tvos", "xros" ] },
