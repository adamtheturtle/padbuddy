          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios", "macos", "xros" ] },
        }, {
          "package": "buddy-kit",
          "product-name": "BuddyAppKit",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios", "macos", "tvos", "xros" ] },
        }, {
          "package": "buddy-kit",
          "product-name": "BuddyDesignSystem",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios", "macos", "tvos", "xros" ] },
        }, {
          "package": "swift-async-algorithms",
          "product-name": "AsyncAlgorithms",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios", "macos", "tvos", "xros" ] },
        }, {
          "package": "swift-sdk",
          "product-name": "MCP",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios", "macos", "tvos", "xros" ] },
        },
