# Xcode user state
xcuserdata/
*.xcuserstate
DerivedData/
DerivedData_localrel/
DerivedData_ipadbuild/
DerivedData_agenttests/
default.profraw
build/
build_release/

# Local release artifacts (a manual sign/notarize/publish run when CI is blocked).
# The notarized .dmg is uploaded to the public coderpad-macos-releases repo, and that
# repo holds the canonical appcast — so these are per-run outputs, never tracked here.
*.dmg
appcast.xml
RELEASE_NOTES.md

# Swift Package Manager build artifacts (per-machine; contain absolute paths)
.build/

# Standalone-resolution lockfile for the in-repo library packages — only created by
# a direct `swift build`. The app's own Package.resolved is authoritative for the
# real build, so this would just drift. (The CoderPadMCP executable keeps its own.)
CoderPadDesignSystem/Package.resolved

# Node tooling for the website lint jobs (docs/) — deps are restored via `npm ci`.
node_modules/
