<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store Info.plist (#483). Identical to coderpad/Info.plist EXCEPT it
	     omits the Sparkle keys (SUFeedURL, SUPublicEDKey, SUEnableInstallerLauncherService):
	     the App Store delivers updates itself and rejects bundled third-party updaters.
	     The App Store target does not link Sparkle, so the updater never reads these. -->
	<!-- The app uses only standard HTTPS/TLS (exempt encryption), so declare it here to
	     skip the export-compliance prompt on every App Store Connect upload (#490). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
