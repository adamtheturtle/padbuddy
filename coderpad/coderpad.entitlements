<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Team-ID-prefixed app group (not the bare "group." form): a notarized
	     Developer-ID build embeds no provisioning profile, and macOS 15+ only
	     authorizes a "group."-prefixed App Group when it's listed in the profile —
	     otherwise it prompts the user to "allow access to data from other apps" on
	     every launch (#451). The "<TeamID>.group." form needs no profile; the system
	     authorizes it by matching the team-ID prefix to the signing identity. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>6L9H6Q8CUF.group.com.adamdangoor.coderpad</string>
	</array>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Sparkle (#28): the sandboxed app talks to Sparkle's Installer XPC service
	     (-spks) and its launcher (-spki) over these mach ports to install updates.
	     The Downloader service (-spkd) is unnecessary because we already hold
	     com.apple.security.network.client. See docs/sparkle-setup.md. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
	<!-- No keychain-access-groups: the app never sets kSecAttrAccessGroup, so it uses
	     its default group ($(AppIdentifierPrefix)$(CFBundleIdentifier)) implicitly. The
	     entitlement only restated that default, but keychain-access-groups is a
	     provisioning-profile-required entitlement — and a Developer-ID build embeds no
	     profile, so declaring it made AMFI refuse to launch the app ("can't be opened" /
	     Launchd job spawn failed). Removing it is functionally identical and fixes launch. -->
</dict>
</plist>
