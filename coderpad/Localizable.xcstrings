          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los pads y las preguntas se almacenan en caché por cuenta, así que al cambiar de sección se muestran al instante tus últimos datos mientras se ejecuta una recarga en segundo plano."
          }
        }
