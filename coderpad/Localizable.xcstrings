    "· %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "· %@"
          }
        }
      }
    },
    "“%@” and its stored API key will be removed from this Mac. This can’t be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se eliminará “%@” y su clave de API almacenada de este Mac. Esto no se puede deshacer."
          }
        }
      }
    },
    "“%@” isn't a valid email address." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” no es una dirección de correo válida."
          }
        }
      }
    },
    "“%@” will be permanently deleted. This can't be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "“%@” se eliminará permanentemente. Esto no se puede deshacer."
          }
        }
      }
    },
    "\"%@\" will be removed. Screen will stop sending event callbacks until a new webhook is set." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Se eliminará «%@». Screen dejará de enviar devoluciones de llamada de eventos hasta que se configure un nuevo webhook."
          }
        }
      }
    },
