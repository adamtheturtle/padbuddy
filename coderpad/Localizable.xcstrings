    "%@ has no edits yet at this point in the session." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ aún no tiene ediciones en este punto de la sesión."
          }
        }
      }
    },
    "%@ is a link to %@. PadBuddy won't write through it, because that would change a file outside the folder you picked. Edit that file directly, or replace the link with a real config file." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is a link to %2$@. PadBuddy won't write through it, because that would change a file outside the folder you picked. Edit that file directly, or replace the link with a real config file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ es un enlace a %2$@. PadBuddy no escribirá a través de él, porque eso modificaría un archivo fuera de la carpeta que elegiste. Edita ese archivo directamente o sustituye el enlace por un archivo de configuración real."
          }
        }
      }
    },
    "%@ isn't a member of this organization, so creating the pad may fail." : {
      "comment" : "Warning when the chosen New Pad owner is not in the loaded organization member list",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no es miembro de esta organización, por lo que la creación del pad puede fallar."
          }
        }
      }
    },
    "%@ isn't a regular file, so PadBuddy can't read or replace it. Check what's at that path and try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no es un archivo normal, así que PadBuddy no puede leerlo ni sustituirlo. Comprueba qué hay en esa ruta y vuelve a intentarlo."
          }
        }
      }
    },
