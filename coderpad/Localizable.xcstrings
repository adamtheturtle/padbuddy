      }
    },
    "%@ is not a regular file, so PadBuddy cannot read or replace it. Check what's at that path and try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%@ no es un archivo normal, así que PadBuddy no puede leerlo ni sustituirlo. Comprueba qué hay en esa ruta y vuelve a intentarlo."
