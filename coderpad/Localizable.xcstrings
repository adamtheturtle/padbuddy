    "%@ is a link to %@. PadBuddy will not write through it, because that would change a file outside the folder you picked. Edit that file directly, or replace the link with a real config file." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is a link to %2$@. PadBuddy will not write through it, because that would change a file outside the folder you picked. Edit that file directly, or replace the link with a real config file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ es un enlace a %2$@. PadBuddy no escribirá a través de él, porque eso modificaría un archivo fuera de la carpeta que elegiste. Edita ese archivo directamente o sustituye el enlace por un archivo de configuración real."
          }
        }
      }
    },
    "%@ is not a member of this organization, so creating the pad may fail." : {
      "comment" : "Warning when the chosen New Pad owner is not in the loaded organization member list",
      "localizations" : {
        "en-GB" : {
