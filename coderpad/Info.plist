			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>list.bullet.rectangle</string>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- Sparkle in-app updates (#28). SUFeedURL points at the appcast on the latest
	     release of the PUBLIC artifacts repo (coderpad-macos-releases), NOT this
	     private source repo: the app fetches the feed + DMG unauthenticated, and a
	     private repo's release assets 404 without a token. release.yml publishes the
	     signed/notarized DMG + appcast there. SUPublicEDKey is the EdDSA public key
	     from Sparkle's `generate_keys`; a mismatch fails signature verification
	     (fail-safe). See docs/sparkle-setup.md. -->
	<key>SUFeedURL</key>
	<string>https://github.com/adamtheturtle/coderpad-macos-releases/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>GM4rpkCx9FMbd+Sk64pU6v6659APlNWYLMKzGU3OIyU=</string>
	<!-- Required for a sandboxed app: routes installs through Sparkle's Installer
	     XPC service (paired with the -spks/-spki mach-lookup entitlements). -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<!-- Custom NSUserActivity types the app advertises (#596). Handoff / Spotlight /
	     Siri prediction of the active pad is silently ignored unless its type is
	     declared here. See PadHandoff.swift. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.adamdangoor.padbuddy.viewing-pad</string>
	</array>
