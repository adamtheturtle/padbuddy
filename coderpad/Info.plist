<plist version="1.0">
<dict>
	<!-- iPad UIKit App Config (#579), ignored on macOS. Declare full orientation
	     support (Apple will require it) - the NavigationSplitView UI already adapts to
	     every size class - and opt into the modern storyboard-less launch screen (an
	     empty UILaunchScreen uses the system background; required going forward). -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
