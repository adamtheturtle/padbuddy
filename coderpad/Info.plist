<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sparkle in-app updates (#28). Inert until the Sparkle package is linked.
	     SUFeedURL points at the appcast attached to the latest GitHub Release
	     (release.yml uploads appcast.xml). SUPublicEDKey MUST be replaced with the
	     EdDSA public key printed by Sparkle's `generate_keys` — the placeholder
	     below makes every update fail signature verification (fail-safe) until set.
	     See docs/sparkle-setup.md. -->
	<key>SUFeedURL</key>
	<string>https://github.com/adamtheturtle/coderpad-macos/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>REPLACE_WITH_SPARKLE_PUBLIC_ED_KEY</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.adamdangoor.coderpad</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>coderpad</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.coderpad.favorite</string>
			<key>UTTypeDescription</key>
			<string>CoderPad Favorite</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict/>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.coderpad.favorite-reorder</string>
			<key>UTTypeDescription</key>
			<string>CoderPad Favorite Reorder</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict/>
		</dict>
	</array>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Open Pad in CoderPad</string>
			</dict>
			<key>NSMessage</key>
			<string>openPad</string>
			<key>NSPortName</key>
			<string>CoderPad</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.url</string>
				<string>public.utf8-plain-text</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
