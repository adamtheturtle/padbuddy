<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Provisioned App Group for iOS/iPadOS and simulator builds. The Team-ID-prefixed
	     macOS Developer ID form is not supported on iOS/iPadOS. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.adamdangoor.padbuddy</string>
	</array>
</dict>
</plist>
